# --- Core (required) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Token encryption (required before connecting Gmail) ---
# 32 random bytes as 64 hex chars:  openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=
TOKEN_ENCRYPTION_KEY_VERSION=1
# During key rotation, keep the previous key here, e.g. TOKEN_ENCRYPTION_KEY_V1=...

# --- Google OAuth (Gmail, read-only) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/api/google/callback
# At least 32 random characters:  openssl rand -base64 48
OAUTH_STATE_SECRET=

# --- Fiverr detection ---
# Optional. Defaults to the sender verified from real samples (e.fiverr.com).
# Setting this REPLACES the default list — only use domains confirmed from real emails.
FIVERR_VERIFIED_SENDER_DOMAINS=
# Optional JSON array of extra subject rules for newly observed formats, e.g.
# [{"category":"new_order","pattern":"^...$","sample":"<real subject>"}]
FIVERR_EXTRA_RULES=

# --- Meta WhatsApp Cloud API ---
META_WA_PHONE_NUMBER_ID=
META_WA_ACCESS_TOKEN=
META_WA_VERIFY_TOKEN=
META_WA_APP_SECRET=
# Utility template for alerts (3 body variables) and authentication template (copy-code OTP)
META_WA_TEMPLATE_ALERT=
META_WA_TEMPLATE_VERIFY=
META_WA_TEMPLATE_LANGUAGE=en
META_WA_API_VERSION=v26.0

# --- Internal scheduler (at least 32 chars) ---
INTERNAL_CRON_SECRET=
